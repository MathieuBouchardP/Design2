%plotter
files = {
"Essai1_0.2V.csv",
"Essai1_0.6V.csv",
"Essai1_-0.2V.csv",
"Essai1_-0.8V.csv",
"Essai1_0.4V.csv",
"Essai1_-0.4V.csv",
"Essai1_-0.6V.csv"
};
names = {
    "E_0.2",
    "E_0.6",
    "E_-0.2",
    "E_-0.8",
    "E_0.4",
    "E_-0.4",
    "E_-0.6"
};


addpath("../Data")
for file = 1:length(files)
    res = read_csv(files{file});
    y3 = res.T3(:,1) - res.T3(1,1) + 25;
    y2 = res.T2(:,1) - res.T2(1,1) + 25;
    y1 = res.T1(:,1) - res.T1(1,1) + 25;
     
    t = res.Temps(:,1);
    fig = figure('Position', [100, 100, 1200, 500]);  % Largeur 800, hauteur 600
    hold on;
    plot(t, y3, 'o');
    plot(t, y2, 's');
    plot(t, y1, '^');
    legend('Température de T3', 'Température de T2', 'Température de T1', 'Location', 'best')
    ax = gca;
    xlabel('Temps [s]')
    ylabel('Température [°C]')
    ax.FontSize = 14;
    axis("auto xy");
    set(gca, 'LooseInset', get(gca, 'TightInset'))
    grid off;
    
    len = length(t);
    factor_stuff = 0.2;
    cuttof_index = round((1-factor_stuff)*len);
    
    f_t_1 = mean(y1(cuttof_index:end,1));
    disp(f_t_1);
    f_t_2 = mean(y2(cuttof_index:end,1));
    disp(f_t_2);
    f_t_3 = mean(y3(cuttof_index:end,1));
    disp(f_t_3);
    print(gcf, sprintf('%s.png', names{file}), '-dpng', '-r600');  % Résolution de 600 dpi

end