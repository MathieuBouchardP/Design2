data = evalin('base','out');
info = data.filtrePWM;
temps = info.time(:,1);

%pwm = info.signals(1).values(:,1);
filtre = info.signals.values(:,1);

hold on
%plot(temps, pwm,'LineWidth',1)
plot(temps, filtre, 'LineWidth',3)
xlabel('Temps [s]')
ylabel('Tension [V]')
%figure ;
%hold on;
plot(moku.data(86800:87800, 1)-12.4, moku.data(86800:87800, 3)-1,'LineWidth',3, 'Color','b');
legend('filtre simulé','filtre mesuré',è)